@model AxiomCRM.Models.Customer

<div class="container mt-4">

    <h2>Add Customer</h2>

    <form asp-action="CreateCustomer" method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <input asp-for="CustomerName"
               class="form-control mb-2"
               placeholder="Customer Name" />

        <input asp-for="Email"
               class="form-control mb-2"
               placeholder="Email" />

        <input asp-for="Phone"
               class="form-control mb-2"
               placeholder="Phone" />

        <input asp-for="CompanyName"
               class="form-control mb-2"
               placeholder="Company Name" />

        <input asp-for="Address"
               class="form-control mb-2"
               placeholder="Address" />

        <input asp-for="City"
               class="form-control mb-2"
               placeholder="City" />

        <input asp-for="State"
               class="form-control mb-3"
               placeholder="State" />

        <button class="btn btn-primary">
            Save Customer
        </button>

        <a asp-action="Customers"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>