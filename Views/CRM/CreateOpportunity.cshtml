@model AxiomCRM.Models.Opportunity

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2>Add Opportunity</h2>

                    <p class="text-muted">
                        Create a new sales opportunity
                    </p>

                    <form asp-action="CreateOpportunity"
                          method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <label class="form-label">
                            Opportunity Name
                        </label>

                        <input asp-for="OpportunityName"
                               class="form-control mb-3"
                               placeholder="Opportunity name" />



                        <label class="form-label">
                            Amount
                        </label>

                        <input asp-for="Amount"
                               type="number"
                               class="form-control mb-3"
                               placeholder="Opportunity amount" />

                        <label class="form-label">
                            Probability (%)
                        </label>

                        <input asp-for="Probability"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control mb-3"
                               placeholder="0 - 100" />

                        <label class="form-label">
                            Expected Close Date
                        </label>

                        <input asp-for="ExpectedCloseDate"
                               type="date"
                               class="form-control mb-3" />

                        <label class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-control mb-4">

                            <option>Open</option>
                            <option>Won</option>
                            <option>Lost</option>

                        </select>

                        <button type="submit"
                                class="btn btn-primary">

                            Save Opportunity

                        </button>

                        <a asp-action="Opportunities"
                           class="btn btn-secondary">

                            Back

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>