@model IEnumerable<AxiomCRM.Models.FollowUp>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h2>Follow-Ups</h2>

            <p class="text-muted">
                Schedule and manage customer follow-ups
            </p>
        </div>

        <a class="btn btn-primary"
           asp-action="CreateFollowUp">
            + Schedule Follow-Up
        </a>

    </div>

    <div class="card mt-3 shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Follow-Up ID</th>
                        <th>Date</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                    </tr>

                </thead>

                <tbody>

                @foreach (var x in Model)
                {
                    <tr>

                        <td>@x.FollowUpId</td>

                        <td>
                            @x.FollowUpDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>@x.AssignedTo</td>

                        <td>
                            @if (x.Status == "Completed")
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (x.FollowUpDate.Date < DateTime.Today)
                            {
                                <span class="badge bg-danger">
                                    Overdue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>