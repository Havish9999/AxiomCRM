@model IEnumerable<AxiomCRM.Models.Lead>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h2>Leads</h2>
            <p class="text-muted">
                Manage and track sales leads
            </p>
        </div>

        <a class="btn btn-primary"
           asp-action="CreateLead">
            + Add Lead
        </a>

    </div>

    <div class="card mt-3 shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Lead</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Assigned To</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                @foreach (var x in Model)
                {
                    <tr>

                        <td>@x.LeadName</td>

                        <td>@x.Email</td>

                        <td>@x.Phone</td>

                        <td>@x.CompanyName</td>

                        <td>@x.Source</td>

                        <td>

                            @if (x.Status == "Qualified")
                            {
                                <span class="badge bg-success">
                                    Qualified
                                </span>
                            }
                            else if (x.Status == "Lost")
                            {
                                <span class="badge bg-danger">
                                    Lost
                                </span>
                            }
                            else if (x.Status == "Converted")
                            {
                                <span class="badge bg-primary">
                                    Converted
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @x.Status
                                </span>
                            }

                        </td>

                        <td>
                            ₹@x.ExpectedValue
                        </td>

                        <td>
                            @x.AssignedTo
                        </td>

                        <td>

                            <a class="btn btn-sm btn-danger"
                               asp-action="DeleteLead"
                               asp-route-id="@x.LeadId">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>