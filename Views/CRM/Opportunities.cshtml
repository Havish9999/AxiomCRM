@model IEnumerable<AxiomCRM.Models.Opportunity>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h2>Opportunities</h2>
            <p class="text-muted">Manage sales opportunities and pipeline</p>
        </div>

        <a class="btn btn-primary"
           asp-action="CreateOpportunity">
            + Add Opportunity
        </a>

    </div>

    <div class="card mt-3 shadow-sm">

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Opportunity</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Close Date</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var x in Model)
                {
                    <tr>

                        <td>@x.OpportunityName</td>


                        <td>₹@x.Amount</td>

                        <td>@x.Probability%</td>

                        <td>
                            @x.ExpectedCloseDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @if (x.Status == "Won")
                            {
                                <span class="badge bg-success">Won</span>
                            }
                            else if (x.Status == "Lost")
                            {
                                <span class="badge bg-danger">Lost</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Open</span>
                            }
                        </td>

                        <td>@x.AssignedTo</td>

                        <td>
                            <a class="btn btn-sm btn-danger"
                               asp-action="DeleteOpportunity"
                               asp-route-id="@x.OpportunityId">
                                Delete
                            </a>
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>