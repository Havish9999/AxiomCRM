<div class="container mt-4">

    <div class="mb-4">
        <h2>CRM Reports</h2>
        <p class="text-muted">
            Overview of CRM performance and sales pipeline
        </p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Customers</h6>
                    <h2>@ViewBag.Customers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Leads</h6>
                    <h2>@ViewBag.Leads</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Opportunities</h6>
                    <h2>@ViewBag.Opportunities</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Won Opportunities</h6>
                    <h2>@ViewBag.Won</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Lost Opportunities</h6>
                    <h2>@ViewBag.Lost</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Pipeline Value</h6>
                    <h2>₹ @ViewBag.PipelineValue</h2>
                </div>
            </div>
        </div>

    </div>

</div>